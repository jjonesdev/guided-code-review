{
  "name": "guided-code-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "bun run build && bun run src/server/cli.ts --fixture",
    "review": "bun run build && bun run src/server/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun test && bun run build",
    "smoke:claude": "bun run src/server/real-claude-smoke.ts"
  },
  "dependencies": {
    "@pierre/diffs": "1.3.2",
    "dompurify": "3.3.3",
    "marked": "17.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.4.1",
    "happy-dom": "20.0.11",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "6.2.0"
  }
}
